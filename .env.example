# 服务仅监听本机；金额单位为 pUSD。
PORT=3100
# 可选：HTTP(S) 出站代理，例如 http://127.0.0.1:7890
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
# 只在你自己的电脑编辑本文件副本 .env。密钥不会发送给前端。
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
# 真实下单需同时打开此开关，并在实盘页面主动启动。
LIVE_TRADING_ENABLED=false
# 价格使用 Polymarket 的 Chainlink 流，按本场配置选择 TWAP 窗口。
# 场次起始价读取 Polymarket 官方事件/价格接口，不回退到交易所现货。
